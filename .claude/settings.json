{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[HARNESS] 파일 변경 감지 — CLAUDE.md 규칙 준수 확인 필요'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[HARNESS] 변경 완료 — progress.md 업데이트 잊지 마세요'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[HARNESS CHECK] 작업 완료 시점 — 검증 체크리스트 확인'"
          }
        ]
      }
    ]
  }
}
